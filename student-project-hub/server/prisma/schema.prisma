// Student Project Hub — database schema
// All primary keys are UUIDs generated by Prisma. Counters on Project
// (likeCount, commentCount) are denormalised and maintained transactionally
// by the services so feeds can sort/display them without aggregate queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ContributorStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  PROJECT_LIKED
  PROJECT_COMMENTED
  COMMENT_REPLIED
  CONTRIBUTOR_INVITED
  CONTRIBUTOR_RESPONDED
}

enum ReportTargetType {
  PROJECT
  COMMENT
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  username        String     @unique
  passwordHash    String
  fullName        String
  university      String
  department      String
  bio             String?    @db.Text
  avatarUrl       String?
  avatarPath      String?
  skills          String[]   @default([])
  githubUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastActiveAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions              UserSession[]
  authTokens            AuthToken[]
  projects              Project[]            @relation("ProjectOwner")
  contributions         ProjectContributor[] @relation("Contributor")
  sentInvitations       ProjectContributor[] @relation("Inviter")
  likes                 Like[]
  comments              Comment[]
  notifications         Notification[]       @relation("NotificationRecipient")
  triggeredNotifications Notification[]      @relation("NotificationActor")
  reports               Report[]             @relation("Reporter")
  reviewedReports       Report[]             @relation("Reviewer")

  @@index([lastActiveAt])
  @@index([createdAt])
  @@index([role])
}

// One row per refresh token (i.e. per signed-in device). Only the SHA-256
// hash of the token is stored; rotation revokes the previous row.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use tokens for email verification and password reset (hashed).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

model Technology {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  projects ProjectTechnology[]
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  description    String        @db.Text
  status         ProjectStatus @default(ONGOING)
  visibility     Visibility    @default(PUBLIC)
  githubUrl      String?
  liveUrl        String?
  coverImageUrl  String?
  coverImagePath String?
  isFeatured     Boolean       @default(false)
  featuredAt     DateTime?
  likeCount      Int           @default(0)
  commentCount   Int           @default(0)
  ownerId        String        @db.Uuid
  categoryId     String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner         User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Categories in use cannot be deleted; admins must reassign projects first.
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologies  ProjectTechnology[]
  images        ProjectImage[]
  contributors  ProjectContributor[]
  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  reports       Report[]

  @@index([visibility, createdAt])
  @@index([visibility, likeCount])
  @@index([categoryId])
  @@index([ownerId])
  @@index([isFeatured, featuredAt])
}

model ProjectTechnology {
  projectId    String @db.Uuid
  technologyId String @db.Uuid

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

// Screenshots. The cover image lives on Project itself.
model ProjectImage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  url       String
  path      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

model ProjectContributor {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  userId      String            @db.Uuid
  invitedById String?           @db.Uuid
  role        String?
  status      ContributorStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("Contributor", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, status])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A user can like a given project at most once.
  @@unique([userId, projectId])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

// Comments nest arbitrarily via parentId. rootId points at the top-level
// comment of the thread so a whole thread can be fetched in one query.
// Deleting a comment soft-deletes it (deletedAt) so replies keep their context.
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  content   String    @db.Text
  projectId String    @db.Uuid
  authorId  String    @db.Uuid
  parentId  String?   @db.Uuid
  rootId    String?   @db.Uuid
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  root          Comment?       @relation("CommentThread", fields: [rootId], references: [id], onDelete: Cascade)
  threadReplies Comment[]      @relation("CommentThread")
  notifications Notification[]
  reports       Report[]

  @@index([projectId, parentId, createdAt])
  @@index([rootId, createdAt])
  @@index([authorId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  type        NotificationType
  recipientId String           @db.Uuid
  actorId     String?          @db.Uuid
  projectId   String?          @db.Uuid
  commentId   String?          @db.Uuid
  message     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  projectId      String?          @db.Uuid
  commentId      String?          @db.Uuid
  reason         String
  details        String?          @db.Text
  status         ReportStatus     @default(PENDING)
  reviewedById   String?          @db.Uuid
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())

  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
}

// Shared counters for the auth rate limits. Serverless instances do not share
// memory, so the limits live in the database (see rate-limit-store.ts).
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

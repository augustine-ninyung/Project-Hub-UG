# ─── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (the client URL).
CORS_ORIGINS=http://localhost:5173
# Public URL of the client; used to build links in emails.
CLIENT_URL=http://localhost:5173
# Public URL of this API; used to build URLs for locally stored uploads.
API_URL=http://localhost:4000
# Number of proxies in front of the API (Vercel counts as one).
TRUST_PROXY=1
# Auth cookie SameSite mode. "lax" when the client and API share a site (local
# dev and Vercel). "none" only for a cross-site setup.
COOKIE_SAME_SITE=lax

# ─── Database ──────────────────────────────────────────────────────────
# `npm run db:local` starts an embedded PostgreSQL that matches this URL.
# On Vercel: the Supabase transaction pooler URL + ?pgbouncer=true&connection_limit=1,
# plus DIRECT_URL = the Supabase session pooler URL (used for migrations only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/student_hub"

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── File storage (Supabase) ───────────────────────────────────────────
# Leave empty in development to store uploads on local disk (server/uploads).
# Required in production. Create a PUBLIC bucket with the name below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public "anon" key (same page). Enables live likes, comments and notifications
# through Supabase Realtime. Optional: without it, pages update on refresh.
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=project-hub

# ─── Email (SMTP) ──────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are printed to the console.
# Required in production (with EMAIL_FROM), or the server refuses to start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Student Project Hub <no-reply@example.com>"
